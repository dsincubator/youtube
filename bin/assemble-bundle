#!/usr/bin/env bash
set -u

PROGRAM="${0##*/}"
usage() {
    cat <<EOF
Usage: $PROGRAM [OPTIONS]
Assemble bundle root index, indexes, log, and references (new build/export layout).

Options:
  -h, --help            Show this message and exit
  --bundle-dir DIR      Bundle directory (project-outdir, default: .)
  --manifest PATH       Planning manifest JSON (default: manifests/planning_manifest.json)
  --bundle-name NAME    Bundle identifier (default: dslab)
  --bundle-tag TAG      Bundle tag (default: ds-lab)
  --playlist-url URL    Playlist URL
EOF
}

BUNDLE_DIR="."
MANIFEST="manifests/planning_manifest.json"
BUNDLE_NAME="dslab"
BUNDLE_TAG="ds-lab"
PLAYLIST_URL=""

need_arg() {
    [[ $# -ge 2 ]] || { echo "[$PROGRAM] $1 needs a value" >&2; exit 2; }
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --bundle-dir) need_arg "$@"; BUNDLE_DIR="$2"; shift 2 ;;
        --manifest) need_arg "$@"; MANIFEST="$2"; shift 2 ;;
        --bundle-name) need_arg "$@"; BUNDLE_NAME="$2"; shift 2 ;;
        --bundle-tag) need_arg "$@"; BUNDLE_TAG="$2"; shift 2 ;;
        --playlist-url) need_arg "$@"; PLAYLIST_URL="$2"; shift 2 ;;
        *) echo "[$PROGRAM] unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

PYTHON="python3"
if [[ -x ".venv/bin/python" ]]; then
    PYTHON=".venv/bin/python"
fi

"$PYTHON" - "$BUNDLE_DIR" "$MANIFEST" "$BUNDLE_NAME" "$BUNDLE_TAG" "$PLAYLIST_URL" <<'PYEOF'
import sys, os, json, glob, shutil, csv
from datetime import datetime, timezone

bundle_dir, manifest_path, bundle_name, bundle_tag, playlist_url = sys.argv[1:6]

# Resolve manifest: support legacy path at bundle_dir/planning_manifest.json
legacy_manifest = os.path.join(bundle_dir, "planning_manifest.json")
if not os.path.exists(manifest_path) and os.path.exists(legacy_manifest):
    manifest_path = legacy_manifest
if os.path.exists(manifest_path):
    with open(manifest_path, encoding="utf-8") as f:
        manifest = json.load(f)
    if not playlist_url:
        playlist_url = manifest.get("playlist_url", "")
else:
    manifest = {"topics": []}

os.makedirs(bundle_dir, exist_ok=True)
# Project intermediaries (NOT indexed)
for d in ["manifests", "assets", "data", "metadata", "transcripts"]:
    os.makedirs(os.path.join(bundle_dir, d), exist_ok=True)
# Wiki (indexed)
wiki_dir = os.path.join(bundle_dir, "wiki")
os.makedirs(wiki_dir, exist_ok=True)
wiki_meta = os.path.join(wiki_dir, "metadata")
wiki_trans = os.path.join(wiki_dir, "transcripts")
wiki_topics = os.path.join(wiki_dir, "topics")
wiki_refs = os.path.join(wiki_dir, "references")
wiki_sources = os.path.join(wiki_dir, "sources")
for d in [wiki_meta, wiki_trans, wiki_topics, wiki_refs]:
    os.makedirs(d, exist_ok=True)

# Determine sources location: build-wiki uses bundle_dir/sources (intermediary) or bundle_dir/wiki/sources
# Also handle legacy bundle_dir/sources
src_candidates = [os.path.join(bundle_dir, "sources"), os.path.join(bundle_dir, "wiki", "sources")]
sources_dir = None
for cand in src_candidates:
    if os.path.isdir(cand):
        sources_dir = cand
        break
if sources_dir is None:
    sources_dir = os.path.join(bundle_dir, "sources")
    os.makedirs(sources_dir, exist_ok=True)

# If sources are in project intermediaries, copy to wiki if bundle_name == dsincubator or has sources
has_sources = False
if os.path.isdir(sources_dir):
    src_files = sorted(glob.glob(os.path.join(sources_dir, "source_*.md")))
    has_sources = len(src_files) > 0
    # For dsincubator, ensure wiki/sources has them; for other bundles, skip unless explicitly has sources
    if has_sources and bundle_name == "dsincubator":
        os.makedirs(wiki_sources, exist_ok=True)
        for sf in src_files:
            dst = os.path.join(wiki_sources, os.path.basename(sf))
            if not os.path.exists(dst):
                try:
                    shutil.copy2(sf, dst)
                except:
                    pass
        # also copy index/log if exists in source_dir
        for extra in ["index.md", "log.md"]:
            s = os.path.join(sources_dir, extra)
            if os.path.isfile(s):
                try:
                    shutil.copy2(s, os.path.join(wiki_sources, extra))
                except:
                    pass
        sources_dir = wiki_sources
    elif has_sources:
        # For test bundles (dslab count 3) we still want wiki/sources to show pipeline works
        # But per spec dslab should not have sources — we include if has_sources but keep wiki index pruning optional
        os.makedirs(wiki_sources, exist_ok=True)
        for sf in src_files:
            dst = os.path.join(wiki_sources, os.path.basename(sf))
            if not os.path.exists(dst):
                try:
                    shutil.copy2(sf, dst)
                except:
                    pass
        sources_dir = wiki_sources
    else:
        sources_dir = wiki_sources if os.path.isdir(wiki_sources) else sources_dir

# Also ensure transcripts copy to wiki
trans_src = os.path.join(bundle_dir, "transcripts")
if os.path.isdir(trans_src):
    for f in glob.glob(os.path.join(trans_src, "*.md")):
        dst = os.path.join(wiki_trans, os.path.basename(f))
        if not os.path.exists(dst) or os.path.getmtime(f) > os.path.getmtime(dst):
            try:
                shutil.copy2(f, dst)
            except:
                pass

# Topics: build-wiki now writes to wiki/topics directly. Also handle legacy bundle_dir/topics
legacy_topics = os.path.join(bundle_dir, "topics")
if os.path.isdir(legacy_topics) and not glob.glob(os.path.join(wiki_topics, "*.md")):
    # copy legacy topics (excluding wiki subdir)
    for root, dirs, files in os.walk(legacy_topics):
        rel = os.path.relpath(root, legacy_topics)
        dst_root = os.path.join(wiki_topics, rel) if rel != "." else wiki_topics
        os.makedirs(dst_root, exist_ok=True)
        for fname in files:
            s = os.path.join(root, fname)
            d = os.path.join(dst_root, fname)
            if not os.path.exists(d):
                try:
                    shutil.copy2(s, d)
                except:
                    pass

# Ensure topics subdirs exist for manifest categories
for t in manifest.get("topics", []):
    cat = t.get("category", "general")
    os.makedirs(os.path.join(wiki_topics, cat), exist_ok=True)

# Count sources for description
src_count = len(glob.glob(os.path.join(wiki_sources, "source_*.md"))) if os.path.isdir(wiki_sources) else len(glob.glob(os.path.join(sources_dir, "source_*.md"))) if os.path.isdir(sources_dir) else 0
if src_count == 0 and os.path.isdir(sources_dir):
    src_count = len(glob.glob(os.path.join(sources_dir, "source_*.md")))
trans_count = len(glob.glob(os.path.join(wiki_trans, "*.md")))

# 1. Wiki root index.md (§12) — PRUNED: no data/manifests/assets links
# Only indexed wiki content: transcripts/, topics/, sources/ (dsincubator only), metadata/, references/, log.md
playlist_line = f"Playlist: {playlist_url}" if playlist_url else f"Bundle: {bundle_name} ({bundle_tag})"
# Determine if we should show sources link: only if has_sources and (bundle_name dsincubator or we have wiki sources)
show_sources = os.path.isdir(wiki_sources) and len(glob.glob(os.path.join(wiki_sources, "source_*.md"))) > 0
sources_line = "- [Sources Index](sources/index.md) (§8) + [Sources Log](sources/log.md) (§9)\n" if show_sources else ""
wiki_index_path = os.path.join(wiki_dir, "index.md")
root_content = f"""---
okf_version: '0.2'
type: Bundle
title: {bundle_name.title()} LLM Wiki Bundle
description: OKF v0.2 LLM wiki bundle for {bundle_name} — {len(manifest.get("topics", []))} topics from {src_count} sources.
tags:
- {bundle_tag}
- wiki-bundle
generated:
  by: agent:okf-wiki-builder/1.0
  at: '2026-09-08'
status: stable
---

# {bundle_name.title()} LLM Wiki Bundle

{playlist_line}

Welcome to the **{bundle_name.title()}** knowledge base bundle, structured according to the Open Knowledge Format (OKF) v0.2.
Transcripts are deterministic: `transcripts/<id>_<slug>.md` bodies are `mm:ss: text` per event from `tStartMs` (no LLM), language prefers `en-orig`/`es-orig`.

## Contents — START HERE
- **Bundle root:** [`index.md`](index.md) (§12)
- [Topics Overview](topics/concepts-overview.md) — all concepts (§3.1)
- [Topics Index](topics/index.md) (§8)
{sources_line}- [Metadata](metadata/metadata.csv) — derived table ([dictionary](metadata/metadata.md))
- [Descriptions](descriptions/) — per-video full YouTube description
- [Transcripts](transcripts/) — `transcripts/<id>_<slug>.md` deterministic `mm:ss: text` per `tStartMs`
- [Bundle History Log](log.md) (§9)
- [References](references/index.md) (§6.3)

## Search
```sh
qmd search "topic" -c {bundle_name} -n 3
qmd query "question" -c {bundle_name} -n 3
```
"""
with open(wiki_index_path, "w", encoding="utf-8") as f:
    f.write(root_content)
# Legacy copy at project root for backward compat (optional, not indexed as wiki but keep)
try:
    shutil.copy2(wiki_index_path, os.path.join(bundle_dir, "index.md"))
except:
    pass

# README.md — wording/format per spec
title_map = {"dslab": "Posit Data Science Lab", "dshangout": "Data Science Hangout", "dsincubator": "Posit Data Science Incubator"}
display_title = title_map.get(bundle_name, bundle_name.replace("-", " ").title())
playlist_md = f"[Playlist]({playlist_url})" if playlist_url else "Playlist"
readme_content = f"""# {display_title} Wiki

Knowledge base of the {display_title} {playlist_md}, structured as an [LLM wiki](https://gist.github.com/karpathy/442a6bf555914893e9891c11519de94f) in the [Open Knowledge Format (OKF)](https://cloud.google.com/blog/products/data-analytics/how-the-open-knowledge-format-can-improve-data-sharing) v0.2.

Both humans and AI-agents should start at [index.md](index.md).

See [tools, tips and tricks](https://gist.github.com/karpathy/442a6bf555914893e9891c11519de94f#optional-cli-tools) to read, query and graph your wiki.
"""
with open(os.path.join(wiki_dir, "README.md"), "w", encoding="utf-8") as f:
    f.write(readme_content)
try:
    shutil.copy2(os.path.join(wiki_dir, "README.md"), os.path.join(bundle_dir, "README.md"))
except:
    pass

# AGENTS.md — wiki maintenance (separate from build AGENTS.md)
agents_path = os.path.join(wiki_dir, "AGENTS.md")
with open(agents_path, "w", encoding="utf-8") as f:
    f.write(f"""# AGENTS.md — {bundle_name} wiki maintenance

This file is for the **exported wiki** (`wiki/`). Build repo AGENTS.md lives at project root.

## Querying the wiki
- Start at [`index.md`](index.md) (§12)
- Topics: [`topics/index.md`](topics/index.md) + [`topics/concepts-overview.md`](topics/concepts-overview.md)
- Transcripts: `transcripts/<id>_<slug>.md` (`mm:ss: text` deterministic)
- Metadata: [`metadata/metadata.csv`](metadata/metadata.csv) ([dictionary](metadata/metadata.md))

## Adding summaries via LLM
- `sources/` is not shipped for `dslab`/`dshangout` (deterministic `bin/*` only). For `dsincubator`, sources are distilled per Extraction Prompt v2.
- To add `summaries/` via LLM, see build `AGENTS.md` Extraction Prompt v2 and `bin/distill-sources`.

## Maintenance
- `log.md` records bundle history (§9)
- `references/` holds external executors/attesters (§6.3)
- Build intermediates (`manifests/`, `assets/`, `data/`) are NOT in this wiki; they live in project-outdir/ and are not indexed.

Generated by `agent:okf-wiki-builder/1.0` per OKF v0.2 §7.
""")

# 2. Topics concepts-overview.md (§3.1) and index.md in wiki
topics_overview_path = os.path.join(wiki_topics, "concepts-overview.md")
topics_content = f"""---
okf_version: '0.2'
type: DirectoryIndex
title: Topics Overview
description: Overview of all aggregated concepts in {bundle_name}.
tags:
- {bundle_tag}
- topics-index
---

# Topics Overview ({bundle_name.title()})

"""
for t in manifest.get("topics", []):
    fname = t.get("topic_filename", "")
    title = t.get("topic_title", "")
    cat = t.get("category", "general")
    topics_content += f"- [{title}]({cat}/{fname}) — {t.get('description', '')}\n"

with open(topics_overview_path, "w", encoding="utf-8") as f:
    f.write(topics_content)

with open(os.path.join(wiki_topics, "index.md"), "w", encoding="utf-8") as f:
    f.write(f"""---
okf_version: '0.2'
type: DirectoryIndex
title: Topics Index
---
# Topics Index
See [Concepts Overview](concepts-overview.md).
""")

# 3. Sources index.md & log.md (§8, §9) — only if wiki_sources exists and has sources
if show_sources:
    os.makedirs(wiki_sources, exist_ok=True)
    sources_list = sorted(glob.glob(os.path.join(wiki_sources, "source_*.md")))
    sources_index_content = f"""---
okf_version: '0.2'
type: DirectoryIndex
title: Sources Index
---
# Sources Index ({bundle_name.title()})

"""
    for s_path in sources_list:
        s_name = os.path.basename(s_path)
        sources_index_content += f"- [{s_name}]({s_name})\n"
    with open(os.path.join(wiki_sources, "index.md"), "w", encoding="utf-8") as f:
        f.write(sources_index_content)
    sources_log_content = f"""---
okf_version: '0.2'
type: Log
title: Sources Ingest Log
---
# Sources Ingest Log
- Initial ingest completed for {len(sources_list)} sources.
"""
    with open(os.path.join(wiki_sources, "log.md"), "w", encoding="utf-8") as f:
        f.write(sources_log_content)
else:
    # Ensure minimal sources index if wiki_sources exists but empty (for completeness)
    if os.path.isdir(wiki_sources):
        with open(os.path.join(wiki_sources, "index.md"), "w", encoding="utf-8") as f:
            f.write(f"""---
okf_version: '0.2'
type: DirectoryIndex
title: Sources Index
---
# Sources Index ({bundle_name.title()})

No distilled sources (deterministic `bin/*` only — see AGENTS.md).
""")

# 4. Wiki log.md (§9) + bundle root log
log_content = f"""---
okf_version: '0.2'
type: Log
title: Bundle History Log
---
# Bundle History Log
- 2026-09-08: Initial assembly of {bundle_name} wiki bundle.
- 2026-09-08: Release tag `{bundle_name}-v0.0.1` — `assets/metadata-raw.tar.gz` + `assets/transcripts-raw.tar.gz` at project-outdir root (siblings of `wiki/`, not indexed).
"""
with open(os.path.join(wiki_dir, "log.md"), "w", encoding="utf-8") as f:
    f.write(log_content)
# legacy copy
try:
    shutil.copy2(os.path.join(wiki_dir, "log.md"), os.path.join(bundle_dir, "log.md"))
except:
    pass

# 5. References index.md (§6.3) in wiki
with open(os.path.join(wiki_refs, "index.md"), "w", encoding="utf-8") as f:
    f.write(f"""---
okf_version: '0.2'
type: References
title: References & External Executors
---
# References
External executors and attestation anchors for {bundle_name}.
""")

# 6. Metadata in wiki/metadata (indexed) — replaces old data/ dictionaries
import csv as _csv
from datetime import datetime, timezone

gen_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
# Try to read metadata.csv from project intermediaries
csv_candidates = [
    os.path.join(bundle_dir, "data", "metadata.csv"),
    os.path.join(bundle_dir, "metadata.csv"),
    os.path.join("data", "metadata.csv"),
]
csv_path_found = None
csv_header = None
csv_rowcount = 0
for _p in csv_candidates:
    if os.path.isfile(_p):
        csv_path_found = _p
        try:
            with open(_p, encoding="utf-8") as _f:
                _r = _csv.DictReader(_f)
                csv_header = _r.fieldnames
                csv_rowcount = sum(1 for _ in _r)
        except Exception:
            pass
        break
if not csv_header:
    csv_header = ["playlist_index","title","id","view_count","like_count","comment_count","upload_date","upload_date_iso","duration","duration_string","channel","uploader","url","description"]

col_desc = {
    "playlist_index": "Playlist position (1-indexed integer from `yt-dlp --flat-playlist --print playlist_index`).",
    "title": "Video title as returned by YouTube (`title`).",
    "id": "YouTube video ID (11-char string; join key to `transcripts/<id>_<slug>.md` and `metadata/<id>.json`).",
    "view_count": "View count at fetch time (`view_count`; integer, may be empty if unavailable).",
    "like_count": "Like count (`like_count`; may be empty if disabled/hidden).",
    "comment_count": "Comment count (`comment_count`; includes available comments).",
    "upload_date": "Upload date as `YYYYMMDD` (`upload_date`).",
    "upload_date_iso": "Upload date normalized to ISO-8601 `YYYY-MM-DD` derived from `upload_date`.",
    "duration": "Duration in seconds (`duration`; integer).",
    "duration_string": "Human-readable duration `H:MM:SS` or `M:SS` derived from `duration`.",
    "channel": "YouTube channel display name (`channel`).",
    "uploader": "Uploader identifier (`uploader`).",
    "url": "Canonical watch URL `https://www.youtube.com/watch?v=<id>` derived from `id`.",
    "description": "Full YouTube video description (`description`), long text quoted CSV field. See per-video `descriptions/<id>_<slug>.md`.",
}

meta_dir = os.path.join(bundle_dir, "metadata")
meta_count = len(glob.glob(os.path.join(meta_dir, "*.json"))) if os.path.isdir(meta_dir) else csv_rowcount

def _gen_block():
    return f"generated:\n  by: \"agent:okf-wiki-builder/1.0\"\n  at: \"{gen_at}\""

release_tag = f"{bundle_name}-v0.0.1"

# Copy metadata.csv to wiki/metadata/metadata.csv (indexed)
if csv_path_found and os.path.isfile(csv_path_found):
    try:
        shutil.copy2(csv_path_found, os.path.join(wiki_meta, "metadata.csv"))
        print(f"[assemble-bundle] copied {csv_path_found} -> wiki/metadata/metadata.csv ({csv_rowcount} rows)")
    except Exception as e:
        print(f"[assemble-bundle] warn copy metadata.csv: {e}")

# wiki/metadata/metadata.md (Concept) — replaces data/metadata.md
with open(os.path.join(wiki_meta, "metadata.md"), "w", encoding="utf-8") as f:
    f.write(f"""---
okf_version: '0.2'
type: Concept
title: Metadata CSV Dictionary
description: Column dictionary for metadata.csv — derived table of YouTube playlist metadata (one row per public video).
tags:
- {bundle_tag}
- data-dictionary
- metadata
{_gen_block()}
status: stable
sources:
- id: {bundle_name}-metadata-csv
  title: "{bundle_name} metadata.csv"
  resource: "metadata.csv"
  author: "Posit PBC"
  usage_count: {csv_rowcount if csv_rowcount else meta_count}
  last_modified: "2026-09-08"
---

# Metadata CSV Dictionary ([metadata.csv](metadata.csv))

Derived table built by `bin/fetch-metadata` from raw dumps `metadata/<id>.json` (see project `assets/metadata-raw.tar.gz`). One row per public video; private/unavailable videos have no row (see `manifests/metadata.tsv` in project-outdir, not indexed).

**Location:** [metadata.csv](metadata.csv) in `wiki/metadata/` (indexed). Project intermediate is `data/metadata.csv` (not indexed). For the canonical `dsincubator` bundle this is `wiki/metadata/metadata.csv`.

**Release:** Raw dumps are published as `assets/metadata-raw.tar.gz` at project-outdir root (not indexed) and attached as GitHub Release asset under tag `{release_tag}` (see `log.md`).

**Columns** (`{",".join(csv_header)}` per `AGENTS.md:9`):

| Column | Description |
|--------|-------------|
""")
    for col in csv_header:
        desc = col_desc.get(col, "")
        f.write(f"| `{col}` | {desc} |\n")
    f.write(f"""
**Join key:** `id` → `transcripts/<id>_<slug>.md` (`resource: https://www.youtube.com/watch?v=<id>`) and `sources/source_<id>_<slug>.md` (if present).

**Provenance:** `yt-dlp --skip-download --dump-single-json` per video → `metadata/<id>.json` (slimmed: `automatic_captions`/`subtitles`/`formats` pruned) → derived `data/metadata.csv` → `wiki/metadata/metadata.csv`. Manifest `manifests/metadata.tsv` (project-only, not indexed) records terminal states.

**Workflow:** download raw → `assets/metadata-raw.tar.gz` sibling → derive `data/metadata.csv` → copy to `wiki/metadata/metadata.csv`.

""")

# wiki/metadata/index.md (§8)
with open(os.path.join(wiki_meta, "index.md"), "w", encoding="utf-8") as f:
    f.write(f"""---
okf_version: '0.2'
type: DirectoryIndex
title: Metadata Index
description: Index of metadata for {bundle_name}.
tags:
- {bundle_tag}
- metadata-index
---

# Metadata Index ({bundle_name.title()})

- [Metadata CSV Dictionary](metadata.md) — column dictionary for `metadata.csv` (derived table, {csv_rowcount} rows)
- [metadata.csv](metadata.csv) — derived table (one row per public video)
- [Descriptions](../descriptions/) — per-video full YouTube description (§4.1 Concept)

Project intermediates (`manifests/`, `assets/`, `data/`) are not indexed; they live in project-outdir/. History in `log.md` (tag `{release_tag}`).
""")

# 6g. wiki/descriptions/<id>_<slug>.md — per-video full YouTube description (§4.1 Concept)
descriptions_dir = os.path.join(wiki_dir, "descriptions")
os.makedirs(descriptions_dir, exist_ok=True)
# Read metadata.csv to get descriptions per video
csv_data = []
if csv_path_found and os.path.isfile(csv_path_found):
    with open(csv_path_found, encoding="utf-8") as _cf:
        _reader = _csv.DictReader(_cf)
        for _row in _reader:
            csv_data.append(_row)
# Fallback: try to read from raw archive if metadata.csv missing/incomplete
if not csv_data:
    # try metadata/<id>.json archived
    if os.path.isdir(meta_dir):
        for _jf in sorted(glob.glob(os.path.join(meta_dir, "*.json"))):
            try:
                with open(_jf, encoding="utf-8") as _jf:
                    _d = json.load(_jf)
                csv_data.append({"id": _d.get("id",""), "title": _d.get("title",""), "description": _d.get("description","")})
            except:
                pass
# Also read metadata.csv from wiki if present (for dslab_build workflow)
if not csv_data and os.path.isfile(os.path.join(wiki_meta, "metadata.csv")):
    with open(os.path.join(wiki_meta, "metadata.csv"), encoding="utf-8") as _cf:
        _reader = _csv.DictReader(_cf)
        for _row in _reader:
            csv_data.append(_row)
for _row in csv_data:
    _vid = _row.get("id", "").strip()
    if not _vid:
        continue
    _title = _row.get("title", "").strip()
    _desc = _row.get("description", "").strip()
    _slug = _title.lower().replace(" ", "-")[:40] if _title else _vid
    # sanitize slug: ascii-only, lowercase, hyphen
    import re as _re, unicodedata as _unic
    _ascii = _unic.normalize('NFKD', _title).encode('ascii', 'ignore').decode('ascii')
    _slug = _re.sub(r'[^a-zA-Z0-9]+', '-', _ascii).strip('-').lower()
    _slug = _re.sub(r'-+', '-', _slug)
    _desc_fm = _desc[:200] + "..." if len(_desc) > 200 else _desc
    _gen_block_val = _gen_block()
    _desc_path = os.path.join(descriptions_dir, f"{_vid}_{_slug}.md")
    with open(_desc_path, "w", encoding="utf-8") as _df:
        _df.write(f"""---
okf_version: '0.2'
type: Concept
title: {_title}
description: Full YouTube description for {_title}.
tags:
- {bundle_tag}
- description
- metadata
{_gen_block_val}
status: stable
sources:
- id: youtube-original
  resource: "https://www.youtube.com/watch?v={_vid}"
  title: "{_title}"
  author: "process:yt-dlp"
  usage_count: {_row.get("view_count", "0")}
  last_modified: "{_row.get("upload_date_iso", "")}
---

# {_title}

{_desc if _desc else "No description available."}

**Resource:** [Watch on YouTube](https://www.youtube.com/watch?v={_vid})
""")
print(f"[assemble-bundle] generated {len(csv_data)} descriptions in wiki/descriptions/")
# descriptions/index.md (§8) — DirectoryIndex for per-video descriptions
with open(os.path.join(descriptions_dir, "index.md"), "w", encoding="utf-8") as _idx:
    _idx.write(f"""---
okf_version: '0.2'
type: DirectoryIndex
title: Descriptions Index
description: Per-video full YouTube descriptions for {bundle_name} ({len(csv_data)} videos).
tags:
- {bundle_tag}
- descriptions-index
---

# Descriptions Index ({bundle_name.title()})

Per-video full YouTube description, one Concept per video (indexed in `descriptions/<id>_<slug>.md`).

""")
    for _row in sorted(csv_data, key=lambda r: r.get("playlist_index", r.get("id",""))):
        _vid2 = _row.get("id","").strip()
        _title2 = _row.get("title","").strip()
        if not _vid2:
            continue
        import re as _re2, unicodedata as _unic2
        _ascii2 = _unic2.normalize('NFKD', _title2).encode('ascii', 'ignore').decode('ascii')
        _slug2 = _re2.sub(r'[^a-zA-Z0-9]+', '-', _ascii2).strip('-').lower()
        _slug2 = _re2.sub(r'-+', '-', _slug2)
        _fname = f"{_vid2}_{_slug2}.md"
        _idx.write(f"- [{_title2}]({_fname}) — `{_vid2}`\n")

# 7. Ensure project manifests/assets indexes (NOT indexed in wiki) — keep at project-outdir root
manifests_dir = os.path.join(bundle_dir, "manifests")
os.makedirs(manifests_dir, exist_ok=True)
# Migrate old manifests if present (legacy)
for old_rel, new_name in [("metadata/manifest.tsv", "metadata.tsv"), ("transcripts/manifest.tsv", "transcripts.tsv")]:
    old_path = os.path.join(bundle_dir, old_rel)
    new_path = os.path.join(manifests_dir, new_name)
    if os.path.isfile(old_path) and not os.path.isfile(new_path):
        try:
            shutil.copy2(old_path, new_path)
            print(f"[assemble-bundle] migrated {old_rel} -> manifests/{new_name}")
        except:
            pass
# Ensure manifests exist
for _name, _header in [("metadata.tsv", "id\tstatus\treason\tfile\n"), ("transcripts.tsv", "id\tstatus\tfile\tlang\n")]:
    _p = os.path.join(manifests_dir, _name)
    if not os.path.isfile(_p):
        _old = os.path.join(bundle_dir, "metadata" if "metadata" in _name else "transcripts", "manifest.tsv")
        if os.path.isfile(_old):
            try:
                shutil.copy2(_old, _p)
                continue
            except:
                pass
        try:
            with open(_p, "w", encoding="utf-8") as _f:
                _f.write(_header)
        except:
            pass
# manifests/index.md (project-only, not indexed in wiki)
with open(os.path.join(manifests_dir, "index.md"), "w", encoding="utf-8") as f:
    f.write(f"""---
okf_version: '0.2'
type: DirectoryIndex
title: Manifests Index
description: Index of fetch manifests for {bundle_name} (project-only, not indexed in wiki).
tags:
- {bundle_tag}
- manifests-index
---

# Manifests Index ({bundle_name.title()})

Fetch manifests kept readable after raw clean (not in `assets/*.tar.gz`). Not indexed in wiki.

- [metadata.tsv](metadata.tsv) — `metadata` fetch manifest (`id | status | reason | file`)
- [transcripts.tsv](transcripts.tsv) — `transcripts` fetch manifest (`id | status | file | lang`)

Source: `bin/fetch-metadata` → `manifests/metadata.tsv` + `assets/metadata-raw.tar.gz`; `bin/fetch-transcripts` → `manifests/transcripts.tsv` + `assets/transcripts-raw.tar.gz`.
""")

# assets index (project-only)
assets_dir = os.path.join(bundle_dir, "assets")
os.makedirs(assets_dir, exist_ok=True)
for _old_tar, _new_tar in [("metadata-raw.tar.gz", "metadata-raw.tar.gz"), ("transcripts-raw.tar.gz", "transcripts-raw.tar.gz")]:
    _old = os.path.join(bundle_dir, _old_tar)
    _new = os.path.join(assets_dir, _new_tar)
    if os.path.isfile(_old) and not os.path.isfile(_new):
        try:
            shutil.move(_old, _new)
            print(f"[assemble-bundle] migrated {_old_tar} -> assets/{_new_tar}")
        except:
            pass
with open(os.path.join(assets_dir, "index.md"), "w", encoding="utf-8") as f:
    f.write(f"""---
okf_version: '0.2'
type: DirectoryIndex
title: Assets Index
description: Index of release assets for {bundle_name} (project-only, not indexed in wiki).
tags:
- {bundle_tag}
- assets-index
---

# Assets Index ({bundle_name.title()})

Release assets (tarballs) at project-outdir root in `assets/` (siblings of `manifests/`/`data/`/`wiki/`). Attached as GitHub Release assets (tag `{release_tag}`). Not indexed in wiki.

- [metadata-raw.tar.gz](metadata-raw.tar.gz) — raw `metadata/<id>.json` dumps (slimmed)
- [transcripts-raw.tar.gz](transcripts-raw.tar.gz) — raw `*.json3`/`*.vtt` captions

Created by `bin/fetch-metadata` (`assets/metadata-raw.tar.gz`) and `bin/convert-transcripts` (`assets/transcripts-raw.tar.gz`), cleaned from `metadata/`/`transcripts/` (keep `manifests/` readable).
""")

# 8. Ensure planning_manifest.json stays in manifests (not wiki) — migrate if at bundle root
if os.path.isfile(os.path.join(bundle_dir, "planning_manifest.json")) and not os.path.isfile(os.path.join(manifests_dir, "planning_manifest.json")):
    try:
        shutil.copy2(os.path.join(bundle_dir, "planning_manifest.json"), os.path.join(manifests_dir, "planning_manifest.json"))
        print(f"[assemble-bundle] migrated planning_manifest.json -> manifests/planning_manifest.json")
    except:
        pass
# If manifest was passed as wiki path, ensure copy in manifests
if manifest_path != os.path.join(manifests_dir, "planning_manifest.json") and os.path.isfile(manifest_path):
    try:
        shutil.copy2(manifest_path, os.path.join(manifests_dir, "planning_manifest.json"))
    except:
        pass

print(f"[assemble-bundle] assembled wiki at {wiki_dir}/ (project-outdir {bundle_dir}/)")
print(f"[assemble-bundle] wiki files: {len(glob.glob(os.path.join(wiki_dir, '**'), recursive=True))} entries")
