#!/usr/bin/env bash
set -u

PROGRAM="${0##*/}"
usage() {
    cat <<EOF
Usage: $PROGRAM [OPTIONS]
Assemble wiki root index, indexes, log, and descriptions (minimal OKF v0.2).

Options:
  -h, --help            Show this message and exit
  --from DIR            Wiki directory (project-outdir, default: .)
  --manifest PATH       Planning manifest JSON (default: manifests/planning_manifest.json)
  --wiki-name NAME      Wiki identifier (default: dslab)
  --wiki-tag TAG        Wiki tag (default: ds-lab)
  --playlist-url URL    Playlist URL
  --playlist-title TITLE Playlist display title
EOF
}

BUNDLE_DIR="."
MANIFEST="manifests/planning_manifest.json"
BUNDLE_NAME="dslab"
BUNDLE_TAG="ds-lab"
PLAYLIST_URL=""
PLAYLIST_TITLE=""

need_arg() {
    [[ $# -ge 2 ]] || { echo "[$PROGRAM] $1 needs a value" >&2; exit 2; }
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --from) need_arg "$@"; BUNDLE_DIR="$2"; shift 2 ;;
        --manifest) need_arg "$@"; MANIFEST="$2"; shift 2 ;;
        --wiki-name) need_arg "$@"; BUNDLE_NAME="$2"; shift 2 ;;
        --wiki-tag) need_arg "$@"; BUNDLE_TAG="$2"; shift 2 ;;
        --playlist-url) need_arg "$@"; PLAYLIST_URL="$2"; shift 2 ;;
        --playlist-title) need_arg "$@"; PLAYLIST_TITLE="$2"; shift 2 ;;
        *) echo "[$PROGRAM] unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

PYTHON="python3"
if [[ -x ".venv/bin/python" ]]; then
    PYTHON=".venv/bin/python"
fi

"$PYTHON" - "$BUNDLE_DIR" "$MANIFEST" "$BUNDLE_NAME" "$BUNDLE_TAG" "$PLAYLIST_URL" "$PLAYLIST_TITLE" <<'PYEOF'
import sys, os, json, glob, shutil, csv, re, unicodedata
from datetime import datetime, timezone

bundle_dir, manifest_path, bundle_name, bundle_tag, playlist_url, playlist_title = sys.argv[1:7]

# Fallback for playlist title: use dirname if not provided
if not playlist_title:
    # Use bundle_name or directory basename as fallback, title-cased
    raw = bundle_name if bundle_name else os.path.basename(os.path.normpath(bundle_dir)) or "Playlist"
    # Replace hyphens/underscores with spaces and title-case
    playlist_title = raw.replace("-", " ").replace("_", " ").title()

# Resolve manifest: support legacy path at bundle_dir/planning_manifest.json
legacy_manifest = os.path.join(bundle_dir, "planning_manifest.json")
if not os.path.exists(manifest_path) and os.path.exists(legacy_manifest):
    manifest_path = legacy_manifest
if os.path.exists(manifest_path):
    with open(manifest_path, encoding="utf-8") as f:
        manifest = json.load(f)
    if not playlist_url:
        playlist_url = manifest.get("playlist_url", "")
else:
    manifest = {"topics": []}

os.makedirs(bundle_dir, exist_ok=True)
# Project intermediaries (NOT indexed)
for d in ["manifests", "assets", "data", "metadata", "transcripts"]:
    os.makedirs(os.path.join(bundle_dir, d), exist_ok=True)

# Wiki (indexed)
wiki_dir = os.path.join(bundle_dir, "wiki")
os.makedirs(wiki_dir, exist_ok=True)
# Clean legacy wiki artifacts from previous builds (minimal: no AGENTS.md, README.md, references)
for _legacy in ["AGENTS.md", "README.md"]:
    _p = os.path.join(wiki_dir, _legacy)
    if os.path.isfile(_p):
        try:
            os.remove(_p)
        except:
            pass
# references/ is not part of deterministic minimal wiki — always remove if present (empty or legacy index.md)
_ref = os.path.join(wiki_dir, "references")
if os.path.isdir(_ref):
    try:
        shutil.rmtree(_ref)
    except:
        pass
# topics/ only after LLM post-processing (manifest has topics)
if os.path.isdir(os.path.join(wiki_dir, "topics")) and not manifest.get("topics"):
    try:
        shutil.rmtree(os.path.join(wiki_dir, "topics"))
    except:
        pass

# --- Transcripts: copy from bundle_dir/transcripts → wiki/transcripts ---
trans_src = os.path.join(bundle_dir, "transcripts")
wiki_trans = os.path.join(wiki_dir, "transcripts")
trans_files = []
if os.path.isdir(trans_src):
    for f in glob.glob(os.path.join(trans_src, "*.md")):
        if os.path.basename(f) == "index.md":
            continue
        trans_files.append(f)
    if trans_files:
        os.makedirs(wiki_trans, exist_ok=True)
        for f in trans_files:
            dst = os.path.join(wiki_trans, os.path.basename(f))
            if not os.path.exists(dst) or os.path.getmtime(f) > os.path.getmtime(dst):
                try:
                    shutil.copy2(f, dst)
                except:
                    pass

# Regenerate list after copy (in case wiki already had files)
wiki_trans_list = []
if os.path.isdir(wiki_trans):
    wiki_trans_list = sorted([p for p in glob.glob(os.path.join(wiki_trans, "*.md")) if os.path.basename(p) != "index.md"])

# Generate transcripts/index.md (§8) — NO frontmatter, progressive disclosure
if wiki_trans_list:
    with open(os.path.join(wiki_trans, "index.md"), "w", encoding="utf-8") as _ti:
        _ti.write("# Transcripts\n\n")
        _ti.write("Deterministic `mm:ss: text` per `tStartMs` (no LLM).\n\n")
        for _p in sorted(wiki_trans_list):
            _name = os.path.basename(_p)
            _ti.write(f"- [{_name}]({_name})\n")
elif os.path.isdir(wiki_trans):
    # Remove empty transcripts dir if no content
    try:
        if not os.listdir(wiki_trans):
            os.rmdir(wiki_trans)
    except:
        pass
    wiki_trans_list = []

# --- Metadata: wiki/metadata/metadata.csv + metadata.md ---
csv_candidates = [
    os.path.join(bundle_dir, "data", "metadata.csv"),
    os.path.join(bundle_dir, "metadata.csv"),
    os.path.join("data", "metadata.csv"),
]
csv_path_found = None
csv_header = None
csv_rowcount = 0
for _p in csv_candidates:
    if os.path.isfile(_p):
        csv_path_found = _p
        try:
            with open(_p, encoding="utf-8") as _f:
                _r = csv.DictReader(_f)
                csv_header = _r.fieldnames
                csv_rowcount = sum(1 for _ in _r)
        except Exception:
            pass
        break
if not csv_header:
    csv_header = ["playlist_index","title","id","view_count","like_count","comment_count","upload_date","upload_date_iso","duration","duration_string","channel","uploader","url","description"]

col_desc = {
    "playlist_index": "Playlist position (1-indexed integer from `yt-dlp --flat-playlist --print playlist_index`).",
    "title": "Video title as returned by YouTube (`title`).",
    "id": "YouTube video ID (11-char string; join key to `transcripts/<id>_<slug>.md` and `metadata/<id>.json`).",
    "view_count": "View count at fetch time (`view_count`; integer, may be empty if unavailable).",
    "like_count": "Like count (`like_count`; may be empty if disabled/hidden).",
    "comment_count": "Comment count (`comment_count`; includes available comments).",
    "upload_date": "Upload date as `YYYYMMDD` (`upload_date`).",
    "upload_date_iso": "Upload date normalized to ISO-8601 `YYYY-MM-DD` derived from `upload_date`.",
    "duration": "Duration in seconds (`duration`; integer).",
    "duration_string": "Human-readable duration `H:MM:SS` or `M:SS` derived from `duration`.",
    "channel": "YouTube channel display name (`channel`).",
    "uploader": "Uploader identifier (`uploader`).",
    "url": "Canonical watch URL `https://www.youtube.com/watch?v=<id>` derived from `id`.",
    "description": "Full YouTube video description (`description`), long text quoted CSV field. See per-video `descriptions/<id>_<slug>.md`.",
}

wiki_meta = os.path.join(wiki_dir, "metadata")
metadata_created = False
if csv_path_found and os.path.isfile(csv_path_found):
    os.makedirs(wiki_meta, exist_ok=True)
    try:
        shutil.copy2(csv_path_found, os.path.join(wiki_meta, "metadata.csv"))
        print(f"[assemble-wiki] copied {csv_path_found} -> wiki/metadata/metadata.csv ({csv_rowcount} rows)")
    except Exception as e:
        print(f"[assemble-wiki] warn copy metadata.csv: {e}")

    # wiki/metadata/metadata.md — minimal frontmatter (§4.1)
    with open(os.path.join(wiki_meta, "metadata.md"), "w", encoding="utf-8") as f:
        f.write("---\n")
        f.write("type: metadata\n")
        f.write("title: Metadata CSV Dictionary\n")
        f.write("description: Column dictionary for metadata.csv — derived table of YouTube playlist metadata.\n")
        f.write("tags: [metadata, data-dictionary]\n")
        if bundle_tag:
            f.write(f"# bundle_tag added as extra: {bundle_tag}\n")
        f.write("---\n\n")
        # Rewrite with proper tags including bundle_tag
        # Re-read and fix tags line (simple approach: rewrite file)
    # Proper rewrite with bundle_tag in tags
    tags_list = ["metadata", "data-dictionary"]
    if bundle_tag:
        tags_list.insert(0, bundle_tag)
    tags_str = ", ".join(f'"{t}"' for t in tags_list)
    cols_joined = ",".join(csv_header)
    with open(os.path.join(wiki_meta, "metadata.md"), "w", encoding="utf-8") as f:
        f.write("---\n")
        f.write("type: metadata\n")
        f.write("title: Metadata CSV Dictionary\n")
        f.write("description: Column dictionary for metadata.csv — derived table of YouTube playlist metadata (one row per public video).\n")
        f.write(f"tags: [{tags_str}]\n")
        f.write("---\n\n")
        f.write("# Metadata CSV Dictionary ([metadata.csv](metadata.csv))\n\n")
        f.write("Derived table built by `bin/fetch-metadata` from raw dumps `metadata/<id>.json`. One row per public video.\n\n")
        f.write(f"**Columns** (`{cols_joined}`):\n\n")
        f.write("| Column | Description |\n")
        f.write("|--------|-------------|\n")
        for col in csv_header:
            desc = col_desc.get(col, "")
            f.write(f"| `{col}` | {desc} |\n")
        f.write(f"\n**Join key:** `id` → `transcripts/<id>_<slug>.md` (`resource: https://www.youtube.com/watch?v=<id>`) and `descriptions/<id>_<slug>.md`.\n")

    # wiki/metadata/index.md (§8) — NO frontmatter
    with open(os.path.join(wiki_meta, "index.md"), "w", encoding="utf-8") as f:
        f.write("# Metadata\n\n")
        f.write(f"- [Metadata CSV Dictionary](metadata.md) — column dictionary for `metadata.csv` ({csv_rowcount} rows)\n")
        f.write("- [metadata.csv](metadata.csv) — derived table (one row per public video)\n")
    metadata_created = True

# --- Descriptions: wiki/descriptions/<id>_<slug>.md — only if CSV description non-empty ---
csv_data = []
if csv_path_found and os.path.isfile(csv_path_found):
    with open(csv_path_found, encoding="utf-8") as _cf:
        _reader = csv.DictReader(_cf)
        for _row in _reader:
            csv_data.append(_row)

descriptions_dir = os.path.join(wiki_dir, "descriptions")
descriptions_created = []
for _row in csv_data:
    _vid = _row.get("id", "").strip()
    if not _vid:
        continue
    _title = _row.get("title", "").strip()
    _desc = _row.get("description", "").strip()
    if not _desc:
        continue  # 1:1 siblings — no file if no description
    import re as _re, unicodedata as _unic
    _ascii = _unic.normalize('NFKD', _title).encode('ascii', 'ignore').decode('ascii')
    _slug = _re.sub(r'[^a-zA-Z0-9]+', '-', _ascii).strip('-').lower()
    _slug = _re.sub(r'-+', '-', _slug)
    if not _slug:
        _slug = _vid
    _trans_filename = f"{_vid}_{_slug}.md"
    # Minimal frontmatter (§4.1)
    tags_list_d = [bundle_tag, "description"] if bundle_tag else ["description"]
    tags_str_d = ", ".join(f'"{t}"' for t in tags_list_d)
    os.makedirs(descriptions_dir, exist_ok=True)
    _desc_path = os.path.join(descriptions_dir, f"{_vid}_{_slug}.md")
    with open(_desc_path, "w", encoding="utf-8") as _df:
        _df.write("---\n")
        _df.write("type: description\n")
        # yaml escape title
        _title_esc = _title.replace('\\', '\\\\').replace('"', '\\"')
        _df.write(f'title: "{_title_esc}"\n')
        _df.write(f'resource: "https://www.youtube.com/watch?v={_vid}"\n')
        _df.write(f"tags: [{tags_str_d}]\n")
        _df.write("---\n\n")
        _df.write(f"# {_title}\n\n")
        _df.write(f"{_desc}\n\n")
        _df.write("---\n\n")
        _df.write(f"See also: [transcript](../transcripts/{_trans_filename}) · [YouTube](https://www.youtube.com/watch?v={_vid})\n")
    descriptions_created.append(_desc_path)

if descriptions_created:
    print(f"[assemble-wiki] generated {len(descriptions_created)} descriptions in wiki/descriptions/")
    # descriptions/index.md (§8) — NO frontmatter
    with open(os.path.join(descriptions_dir, "index.md"), "w", encoding="utf-8") as _idx:
        _idx.write("# Descriptions\n\n")
        _idx.write(f"Per-video full YouTube descriptions ({len(descriptions_created)} videos).\n\n")
        for _row in sorted(csv_data, key=lambda r: r.get("playlist_index", r.get("id",""))):
            _vid2 = _row.get("id","").strip()
            _desc2 = _row.get("description","").strip()
            if not _vid2 or not _desc2:
                continue
            _title2 = _row.get("title","").strip()
            import re as _re2, unicodedata as _unic2
            _ascii2 = _unic2.normalize('NFKD', _title2).encode('ascii', 'ignore').decode('ascii')
            _slug2 = _re2.sub(r'[^a-zA-Z0-9]+', '-', _ascii2).strip('-').lower()
            _slug2 = _re2.sub(r'-+', '-', _slug2)
            if not _slug2:
                _slug2 = _vid2
            _fname = f"{_vid2}_{_slug2}.md"
            _idx.write(f"- [{_title2}]({_fname}) — `{_vid2}`\n")
else:
    # Remove empty descriptions dir if created
    if os.path.isdir(descriptions_dir):
        try:
            if not os.listdir(descriptions_dir):
                os.rmdir(descriptions_dir)
        except:
            pass
    print(f"[assemble-wiki] generated 0 descriptions in wiki/descriptions/ (all empty)")

# --- Topics: only if manifest has topics (post-processing) ---
# No deterministic topics — handled only after LLM post-processing
# If manifest has topics, topics generation is handled by re-index step (out of scope for minimal pass)

# --- Wiki root index.md (§12) — ONLY place with okf_version, minimal frontmatter ---
trans_count = len(wiki_trans_list)
desc_count = len(descriptions_created)
playlist_md = f"[Playlist]({playlist_url})" if playlist_url else "Playlist"
tags_root = [bundle_tag, "wiki-bundle"] if bundle_tag else ["wiki-bundle"]
tags_root_str = ", ".join(f'"{t}"' for t in tags_root)
wiki_index_path = os.path.join(wiki_dir, "index.md")
# yaml escape for title
_pt_esc = playlist_title.replace('\\', '\\\\').replace('"', '\\"')
with open(wiki_index_path, "w", encoding="utf-8") as f:
    f.write("---\n")
    f.write('okf_version: "0.2"\n')
    f.write("type: Bundle\n")
    f.write(f'title: "{_pt_esc} Wiki"\n')
    f.write(f'description: OKF v0.2 wiki for {bundle_name} — {trans_count} transcripts, {desc_count} descriptions.\n')
    f.write(f"tags: [{tags_root_str}]\n")
    f.write("---\n\n")
    f.write(f"# {playlist_title} Wiki\n\n")
    f.write(f"Knowledge base of the {playlist_title} {playlist_md}, structured as an [LLM wiki](https://gist.github.com/karpathy/442a6bf555914893e9891c11519de94f) in the [Open Knowledge Format (OKF)](https://cloud.google.com/blog/products/data-analytics/how-the-open-knowledge-format-can-improve-data-sharing) v0.2.\n\n")
    f.write("See [tools, tips and tricks](https://gist.github.com/karpathy/442a6bf555914893e9891c11519de94f#optional-cli-tools) to read, query and graph your wiki.\n\n")
    f.write("## Contents — START HERE\n")
    f.write("- **Bundle root:** [`index.md`](index.md) (§12)\n")
    if metadata_created:
        f.write("- [Metadata](metadata/metadata.csv) — derived table ([dictionary](metadata/metadata.md))\n")
    if wiki_trans_list:
        f.write("- [Transcripts](transcripts/index.md) — `transcripts/<id>_<slug>.md` deterministic `mm:ss: text` per `tStartMs` (§8)\n")
    if descriptions_created:
        f.write("- [Descriptions](descriptions/index.md) — per-video full YouTube description (§8)\n")
    f.write("- [Bundle History Log](log.md) (§9)\n")

# --- Wiki log.md (§9) — NO frontmatter ---
log_path = os.path.join(wiki_dir, "log.md")
today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
with open(log_path, "w", encoding="utf-8") as f:
    f.write("# Bundle History Log\n\n")
    f.write(f"## {today}\n")
    f.write(f"- **Creation**: Assembled {bundle_name} wiki — {trans_count} transcripts, {desc_count} descriptions.\n")

print(f"[assemble-wiki] assembled wiki at {wiki_dir}/ (project-outdir {bundle_dir}/)")
# Count wiki files recursively
wiki_files = []
for root, dirs, files in os.walk(wiki_dir):
    for fn in files:
        wiki_files.append(os.path.join(root, fn))
print(f"[assemble-wiki] wiki files: {len(wiki_files)} entries")
PYEOF
