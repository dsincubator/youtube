#!/usr/bin/env bash
set -euo pipefail

PROGRAM="${0##*/}"
usage() {
    cat <<EOF
Usage: $PROGRAM [OPTIONS]
Orchestrate the full OKF LLM wiki build pipeline.

Options:
  -h, --help            Show this message and exit
  --playlist URL        YouTube playlist URL (required)
  --name NAME           Bundle identifier (default: dslab)
  --tag TAG             Bundle tag (default: ds-lab)
  --out-dir DIR         Output bundle directory (default: dslab)
  -n, --count N         Limit processing to the first N videos
EOF
}

PLAYLIST=""
BUNDLE_NAME="dslab"
BUNDLE_TAG="ds-lab"
OUT_DIR="dslab"
COUNT=0

need_arg() {
    [[ $# -ge 2 ]] || { echo "[$PROGRAM] $1 needs a value" >&2; exit 2; }
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --playlist) need_arg "$@"; PLAYLIST="$2"; shift 2 ;;
        --name) need_arg "$@"; BUNDLE_NAME="$2"; shift 2 ;;
        --tag) need_arg "$@"; BUNDLE_TAG="$2"; shift 2 ;;
        --out-dir) need_arg "$@"; OUT_DIR="$2"; shift 2 ;;
        -n|--count) need_arg "$@"; COUNT="$2"; shift 2 ;;
        *) echo "[$PROGRAM] unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ -z "$PLAYLIST" ]]; then
    echo "[$PROGRAM] error: --playlist URL is required" >&2
    usage >&2
    exit 2
fi

mkdir -p "$OUT_DIR/metadata" "$OUT_DIR/transcripts" "$OUT_DIR/sources" "$OUT_DIR/topics" "$OUT_DIR/manifests" "$OUT_DIR/assets"

CSV_PATH="$OUT_DIR/metadata.csv"
if [[ ! -f "$CSV_PATH" ]]; then
    echo "playlist_index,title,id,view_count,like_count,comment_count,upload_date,upload_date_iso,duration,duration_string,channel,uploader,url" > "$CSV_PATH"
fi

echo "=== Step 1: Fetching Metadata ==="
CMD_META=(./bin/fetch-metadata --playlist "$PLAYLIST" --csv "$CSV_PATH" --meta-dir "$OUT_DIR/metadata")
[[ "$COUNT" -gt 0 ]] && CMD_META+=(--limit "$COUNT")
"${CMD_META[@]}"

echo "=== Step 2: Fetching Transcripts ==="
CMD_TRANS=(./bin/fetch-transcripts --csv "$CSV_PATH" --out-dir "$OUT_DIR/transcripts")
[[ "$COUNT" -gt 0 ]] && CMD_TRANS+=(--count "$COUNT")
"${CMD_TRANS[@]}"

echo "=== Step 3: Converting Transcripts to OKF Markdown ==="
CMD_CONV=(./bin/convert-transcripts --csv "$CSV_PATH" --out-dir "$OUT_DIR/transcripts" --format md --tag "$BUNDLE_TAG")
[[ "$COUNT" -gt 0 ]] && CMD_CONV+=(--count "$COUNT")
"${CMD_CONV[@]}"

echo "=== Step 4: Distilling Sources ==="
CMD_DIST=(./bin/distill-sources --csv "$CSV_PATH" --transcripts-dir "$OUT_DIR/transcripts" --out-dir "$OUT_DIR/sources" --tag "$BUNDLE_TAG")
[[ "$COUNT" -gt 0 ]] && CMD_DIST+=(--count "$COUNT")
"${CMD_DIST[@]}"

echo "=== Step 5: Clustering Topics ==="
./bin/cluster-topics --sources-dir "$OUT_DIR/sources" --out-file "$OUT_DIR/planning_manifest.json" --bundle-name "$BUNDLE_NAME" --playlist-url "$PLAYLIST"

echo "=== Step 6: Generating Topics ==="
./bin/generate-topics --manifest "$OUT_DIR/planning_manifest.json" --sources-dir "$OUT_DIR/sources" --out-dir "$OUT_DIR/topics"

echo "=== Step 6b: Ensuring Raw Archives ==="
python3 - "$OUT_DIR" <<'PYEOF'
import os, sys, glob, tarfile, shutil
bundle_dir = sys.argv[1]
# Migrate old tars to assets/ if needed
for old_rel, new_rel in [("metadata-raw.tar.gz", "assets/metadata-raw.tar.gz"), ("transcripts-raw.tar.gz", "assets/transcripts-raw.tar.gz")]:
    old_p = os.path.join(bundle_dir, old_rel)
    new_p = os.path.join(bundle_dir, new_rel)
    if os.path.isfile(old_p) and not os.path.isfile(new_p):
        os.makedirs(os.path.dirname(new_p), exist_ok=True)
        try:
            shutil.move(old_p, new_p)
            print(f"[build-wiki] migrated {old_rel} -> {new_rel}")
        except:
            pass
# Migrate old manifests to manifests/ if needed
for old_rel, new_rel in [("metadata/manifest.tsv", "manifests/metadata.tsv"), ("transcripts/manifest.tsv", "manifests/transcripts.tsv")]:
    old_p = os.path.join(bundle_dir, old_rel)
    new_p = os.path.join(bundle_dir, new_rel)
    if os.path.isfile(old_p) and not os.path.isfile(new_p):
        os.makedirs(os.path.dirname(new_p), exist_ok=True)
        try:
            shutil.copy2(old_p, new_p)
            print(f"[build-wiki] migrated {old_rel} -> {new_rel}")
        except:
            pass
# metadata-raw.tar.gz in assets/
meta_dir = os.path.join(bundle_dir, "metadata")
tar_meta = os.path.join(bundle_dir, "assets", "metadata-raw.tar.gz")
os.makedirs(os.path.dirname(tar_meta), exist_ok=True)
if not os.path.isfile(tar_meta):
    jfiles = sorted([f for f in glob.glob(os.path.join(meta_dir, "*.json")) if not os.path.basename(f).startswith("._")])
    if jfiles:
        tmp = tar_meta + ".tmp"
        with tarfile.open(tmp, "w:gz") as tar:
            for f in jfiles:
                tar.add(f, arcname=os.path.basename(f))
        os.replace(tmp, tar_meta)
        print(f"[build-wiki] ensured {tar_meta} ({len(jfiles)} files)")
        for f in jfiles:
            try:
                os.remove(f)
            except:
                pass
    else:
        print(f"[build-wiki] skip metadata-raw: no json in {meta_dir}/")
else:
    print(f"[build-wiki] exists {tar_meta}")
# transcripts-raw.tar.gz in assets/
trans_dir = os.path.join(bundle_dir, "transcripts")
tar_trans = os.path.join(bundle_dir, "assets", "transcripts-raw.tar.gz")
os.makedirs(os.path.dirname(tar_trans), exist_ok=True)
if not os.path.isfile(tar_trans):
    raw_pats = ["*.json3","*.srv3","*.srv2","*.srv1","*.vtt","*.srt","*.ttml","*.sbv","*.tsv","*.txt"]
    raw_files = []
    for pat in raw_pats:
        raw_files.extend(glob.glob(os.path.join(trans_dir, pat)))
    raw_files = [f for f in raw_files if os.path.basename(f) not in ("manifest.tsv","transcripts.tsv") and not os.path.basename(f).startswith("._")]
    if raw_files:
        tmp = tar_trans + ".tmp"
        with tarfile.open(tmp, "w:gz") as tar:
            for f in sorted(raw_files):
                tar.add(f, arcname=os.path.basename(f))
        os.replace(tmp, tar_trans)
        print(f"[build-wiki] ensured {tar_trans} ({len(raw_files)} raw files)")
        for f in raw_files:
            try:
                os.remove(f)
            except:
                pass
    else:
        print(f"[build-wiki] no raw transcripts to archive (kept .md only, tar sibling already clean)")
else:
    print(f"[build-wiki] exists {tar_trans}")
PYEOF

echo "=== Step 7: Assembling Bundle ==="
./bin/assemble-bundle --bundle-dir "$OUT_DIR" --manifest "$OUT_DIR/planning_manifest.json" --bundle-name "$BUNDLE_NAME" --bundle-tag "$BUNDLE_TAG" --playlist-url "$PLAYLIST"

echo "=== Build Complete! Wiki bundle ready at $OUT_DIR/index.md ==="
