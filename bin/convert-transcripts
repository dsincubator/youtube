#!/usr/bin/env bash
set -u

PROGRAM="${0##*/}"
usage() {
    cat <<EOF
Usage: $PROGRAM [OPTIONS] [CSV] [OUT_DIR]
Convert transcripts/*.json3 to readable formats.

Options:
  -h, --help            Show this message and exit
  --csv PATH            Metadata CSV (default: data/metadata.csv)
  --from DIR            Transcripts directory (default: transcripts)
  --format FORMAT       Output format: txt, tsv, md, both, or all (default: both)
                         txt: plain text, tsv: tab-separated, md: OKF markdown,
                         both: txt+tsv, all: txt+tsv+md
  --wiki-tag TAG        Wiki tag for frontmatter tags (default: empty)
  -n, --count N         Process only the first N videos
EOF
}

CSV="data/metadata.csv"
OUT_DIR="transcripts"
FORMAT="both"
TAG=""
COUNT=0

need_arg() {
    [[ $# -ge 2 ]] || { echo "[$PROGRAM] $1 needs a value" >&2; exit 2; }
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --csv) need_arg "$@"; CSV="$2"; shift 2 ;;
        --from) need_arg "$@"; OUT_DIR="$2"; shift 2 ;;
        --format) need_arg "$@"; FORMAT="$2"; shift 2 ;;
        --wiki-tag) need_arg "$@"; TAG="$2"; shift 2 ;;
        -n|--count) need_arg "$@"; COUNT="$2"; shift 2 ;;
        *)
            if [[ "$1" == *.csv ]]; then CSV="$1"
            elif [[ "$1" == transcripts* ]]; then OUT_DIR="$1"
            elif [[ "$1" == "txt" || "$1" == "tsv" || "$1" == "md" || "$1" == "both" || "$1" == "all" ]]; then
                FORMAT="$1"
            else
                echo "[$PROGRAM] unknown option: $1" >&2; usage >&2; exit 2
            fi
            shift
            ;;
    esac
done

python3 - "$CSV" "$OUT_DIR" "$FORMAT" "$COUNT" "$TAG" <<'PYEOF'
import csv, json, os, sys, re, unicodedata
from datetime import datetime, timezone

csv_path, out_dir, fmt, count_str, tag = sys.argv[1:6]
count = int(count_str)

def slugify(title):
    ascii_title = unicodedata.normalize('NFKD', title).encode('ascii', 'ignore').decode('ascii')
    slug = re.sub(r'[^a-zA-Z0-9]+', '-', ascii_title).strip('-').lower()
    slug = re.sub(r'-+', '-', slug)
    return slug

def yaml_escape(s):
    s = s.replace('\\', '\\\\').replace('"', '\\"')
    return f'"{s}"'

with open(csv_path) as f:
    rows = {}
    for row in csv.DictReader(f):
        vid_key = row["id"].strip()
        rows[vid_key] = {
            "title": row.get("title", "").strip(),
            "views": row.get("view_count", "").strip(),
            "uploaded": row.get("upload_date_iso", "").strip(),
        }
    ids = list(rows.keys())

if count > 0:
    ids = ids[:count]

gen_ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

# Keyword rules for topical tags, in priority order. Scanned against the
# video title + transcript body (lowercased). First matches win, capped.
TAG_RULES = [
    ("test driven", "tdd"), ("tdd", "tdd"),
    ("snapshot", "snapshot-testing"), ("code coverage", "code-coverage"),
    ("testthat", "testthat"), ("testing", "testing"),
    ("merge conflict", "merge-conflicts"), ("rebase", "rebasing"),
    ("pull request", "pull-requests"), ("github", "github"),
    ("gitflow", "gitflow"), ("git", "git"),
    ("usethis", "usethis"), ("cran", "cran"),
    ("roxygen", "documentation"), ("pkgdown", "pkgdown"),
    ("r package", "r-packages"), ("package", "r-packages"),
    ("targets", "targets"), ("drake", "drake"),
    ("memois", "memoisation"), ("pipeline", "pipelines"),
    ("reproducib", "reproducibility"),
    ("ggplot2", "ggplot2"), ("dplyr", "dplyr"),
    ("tidyverse", "tidyverse"),
    ("exploratory data", "eda"), ("eda", "eda"),
    ("tidy data", "tidy-data"),
    ("docker", "docker"), ("rocker", "rocker"),
    ("container", "containers"), ("compose", "docker-compose"),
    ("cloud run", "cloud-run"), ("google cloud", "google-cloud"),
    ("azure", "azure"), ("cloud", "cloud"),
    ("shiny", "shiny"), ("reactiv", "reactivity"),
    ("tmux", "tmux"), ("terminal", "terminal"),
    ("shell", "shell"), ("command line", "cli"),
    ("reprex", "reprex"), ("code review", "code-reviews"),
    ("stand-up", "standups"), ("standup", "standups"),
    ("pair programming", "pair-programming"),
    ("debugging", "debugging"), ("debug", "debugging"),
    ("scrap", "web-scraping"), ("api", "apis"),
    ("dbt", "dbt"), ("databricks", "databricks"),
    ("database", "databases"), ("rdbms", "databases"),
    ("reticulate", "python"), ("python", "python"),
    ("chromebook", "chromebook"), ("r2dii", "r2dii"),
    ("pins", "pins"), ("dropbox", "dropbox"),
    ("quarto", "quarto"), ("r markdown", "rmarkdown"),
    ("refactor", "refactoring"),
    ("hidden argument", "code-quality"),
    ("type-inconsistent", "code-quality"),
    ("permission", "permissions"),
    ("a/b test", "ab-testing"),
    ("workflow", "workflow"), ("issue", "github-issues"),
]

def topical_tags(title, body_text, limit=4):
    title_low = title.lower()
    body_low = body_text[:20000].lower()
    scored = {}
    for kw, tag in TAG_RULES:
        if tag in scored:
            continue
        # Short keywords need word boundaries ("eda" matches "queda").
        pat = r"\b" + re.escape(kw) + r"\b" if len(kw) <= 3 else re.escape(kw)
        in_title = re.search(pat, title_low) is not None
        score = len(re.findall(pat, body_low))
        if in_title:
            score += 3
        # Single incidental mentions in the body are noise; a title
        # match or repeated body mentions are signal.
        if in_title or score >= 2:
            scored[tag] = score
    ranked = sorted(scored, key=lambda t: scored[t], reverse=True)
    return ranked[:limit]

def do_md(base, path, vid):
    with open(path) as f:
        data = json.load(f)
    meta = rows.get(vid, {})
    title = meta.get("title", "")
    events = data.get("events", [])
    body_lines = []
    plain_lines = []
    for ev in events:
        segs = ev.get("segs", [])
        text = "".join(seg.get("utf8", "") for seg in segs).strip()
        if not text:
            continue
        plain_lines.append(text)
        t_ms = ev.get("tStartMs", 0)
        try:
            total_s = int(t_ms) // 1000
        except Exception:
            total_s = 0
        m, s = divmod(total_s, 60)
        h, m = divmod(m, 60)
        ts = f"{h}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"
        body_lines.append(f"{ts}: {text}")
    body = "\n\n".join(body_lines)
    plain_body = "\n\n".join(plain_lines)
    if not body:
        body = "No transcript content."
        plain_body = body
    lang = "en"
    m = re.search(r"\.([a-z]{2})(?:-orig)?\.json3$", os.path.basename(path))
    if m:
        lang = m.group(1)
    # ml03: deterministic, no heuristic (LLM post-processing optional)
    # ml04: tag may be empty (derived from --from via build-wiki); skip empty
    # ml05 minimal: only required (type) + useful+raw (title, resource, lang, tags) + generated
    base_tags = ([tag] if tag else []) + topical_tags(title, plain_body)
    slug = slugify(title) if title else vid
    md_path = out_dir + "/" + vid + "_" + slug + ".md"
    # cross-link filename deterministic from id+slug (ml02 handles empty title -> vid fallback)
    desc_filename = f"{vid}_{slug}.md"
    fm_lines = [
        "---",
        "type: transcript",
        f"title: {yaml_escape(title)}",
        f"resource: \"https://www.youtube.com/watch?v={vid}\"",
        "tags: [" + ", ".join(f'"{t}"' for t in base_tags) + "]",
        f"lang: {lang}",
        "generated:",
        "  by: \"process:convert-transcripts\"",
        f"  at: \"{gen_ts}\"",
    ]
    fm = "\n".join(fm_lines)
    # ml02: explicit cross-link to sibling description (same id_slug, different dir) — resilient to empty description
    body_footer = f"\n\n---\n\nSee also: [description](../descriptions/{desc_filename}) · [YouTube](https://www.youtube.com/watch?v={vid})"
    frontmatter = fm + "\n---\n\n# Transcript\n\n" + body + body_footer + "\n"
    with open(md_path, "w") as f:
        f.write(frontmatter)

ok = 0
for vid in ids:
    path = None
    for name in os.listdir(out_dir):
        if name.startswith(vid + ".") and name.endswith(".json3"):
            path = os.path.join(out_dir, name)
            break
    if not path or not os.path.isfile(path):
        continue

    base = path.replace(".json3", "")
    generate_txt = fmt in ("txt", "both", "all")
    generate_tsv = fmt in ("tsv", "both", "all")
    generate_md = fmt in ("md", "all")

    if generate_txt or generate_tsv:
        with open(path) as f:
            data = json.load(f)
        events = data.get("events", [])
        lines = []
        tsv_rows = []
        for ev in events:
            t_start = ev.get("tStartMs", 0)
            segs = ev.get("segs", [])
            text_parts = []
            for seg in segs:
                utf8 = seg.get("utf8", "")
                t_offset = seg.get("tOffsetMs", 0)
                text_parts.append(utf8)
                tsv_rows.append((t_start + t_offset, utf8))
            text = "".join(text_parts).strip()
            if text:
                lines.append(text)
                tsv_rows.append((t_start, "__EVENT__"))
        if generate_txt:
            with open(base + ".txt", "w") as f:
                f.write("\n".join(lines) + "\n")
        if generate_tsv:
            with open(base + ".tsv", "w") as f:
                for t, text in tsv_rows:
                    f.write(f"{t}\t{text}\n")
        ok += 1

    if generate_md:
        do_md(base, path, vid)
        ok += 1

# -- Archive raw captions as sibling assets/transcripts-raw.tar.gz (keep .md readable)
# Bundle root = parent of out_dir, e.g. out_dir=dslab/transcripts -> dslab/
if ok > 0:
    import glob as _glob, tarfile as _tarfile, os as _os2
    bundle_root = os.path.dirname(os.path.normpath(out_dir)) or "."
    tar_path = os.path.join(bundle_root, "assets", "transcripts-raw.tar.gz")
    _os2.makedirs(os.path.dirname(tar_path), exist_ok=True)
    # Migrate old tar if present
    old_tar = os.path.join(bundle_root, "transcripts-raw.tar.gz")
    if _os2.path.isfile(old_tar) and not _os2.path.isfile(tar_path):
        try:
            _os2.rename(old_tar, tar_path)
            print(f"[convert-transcripts] migrated {old_tar} -> {tar_path}")
        except OSError:
            pass
    # Collect raw files inside out_dir (keep .md and manifest.tsv)
    raw_patterns = ["*.json3", "*.srv3", "*.srv2", "*.srv1", "*.vtt", "*.srt", "*.ttml", "*.sbv", "*.tsv", "*.txt"]
    raw_files = []
    for pat in raw_patterns:
        raw_files.extend(_glob.glob(os.path.join(out_dir, pat)))
    # Keep manifest.tsv readable; don't archive AppleDouble or tarball itself
    raw_files = [f for f in raw_files if os.path.basename(f) != "manifest.tsv" and not os.path.basename(f).startswith("._") and not f.endswith("transcripts-raw.tar.gz")]
    if raw_files:
        tmp_tar = tar_path + ".tmp"
        with _tarfile.open(tmp_tar, "w:gz") as tar:
            for f in sorted(raw_files):
                tar.add(f, arcname=os.path.basename(f))
        os.replace(tmp_tar, tar_path)
        print(f"[convert-transcripts] archived {len(raw_files)} raw files -> {tar_path}")
        # Remove raw files from transcripts/ (keep .md + manifest.tsv + transcripts-raw.tar.gz sibling)
        for f in raw_files:
            try:
                os.remove(f)
            except OSError:
                pass
        print(f"[convert-transcripts] cleaned {len(raw_files)} raw files from {out_dir}/ (kept .md)")

print(f"[convert-transcripts] converted {ok}/{len(ids)} transcripts ({fmt} format)")
PYEOF
