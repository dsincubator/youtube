#!/usr/bin/env bash
set -u

PROGRAM="${0##*/}"
usage() {
    cat <<EOF
Usage: $PROGRAM [OPTIONS]
Fetch auto-generated transcripts for all videos in data/metadata.csv.

Outputs: transcripts/<id>.<lang>.json3 per video, transcripts/manifest.tsv linking back to data/metadata.csv.

Options:
  -h, --help            Show this help message and exit
  --force               Re-fetch transcripts even if the output file already exists
  --cookies-from-browser BROWSER
                        Pass --cookies-from-browser to yt-dlp (e.g. chrome, firefox)
  -n, --count N         Process only the first N videos (for testing)
  --csv PATH            Path to the metadata CSV (default: data/metadata.csv)
  --out-dir DIR         Output directory (default: transcripts)
  --sub-format FORMAT   Subtitle format preference (default: json3/srv3/vtt/best)
  --sleep SECONDS       Seconds to wait between videos (default: 1)
  --retries N           Total attempts per video (default: 3)
EOF
}

FORCE=0
COOKIES=""
COUNT=0
CSV="data/metadata.csv"
OUT_DIR="transcripts"
SUB_FORMAT="json3/srv3/vtt/best"
SLEEP=1
RETRIES=3

need_arg() {
    [[ $# -ge 2 ]] || { echo "[fetch-transcripts] $1 needs a value" >&2; exit 2; }
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --force) FORCE=1; shift ;;
        --cookies-from-browser) need_arg "$@"; COOKIES="--cookies-from-browser $2"; shift 2 ;;
        -n|--count) need_arg "$@"; COUNT="$2"; shift 2 ;;
        --csv) need_arg "$@"; CSV="$2"; shift 2 ;;
        --out-dir) need_arg "$@"; OUT_DIR="$2"; shift 2 ;;
        --sub-format) need_arg "$@"; SUB_FORMAT="$2"; shift 2 ;;
        --sleep) need_arg "$@"; SLEEP="$2"; shift 2 ;;
        --retries) need_arg "$@"; RETRIES="$2"; shift 2 ;;
        *) echo "[fetch-transcripts] unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

[[ "$COUNT" =~ ^[0-9]+$ ]] || { echo "[fetch-transcripts] --count must be a non-negative integer" >&2; exit 2; }
[[ "$SLEEP" =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "[fetch-transcripts] --sleep must be a non-negative number" >&2; exit 2; }
[[ "$RETRIES" =~ ^[0-9]+$ ]] || { echo "[fetch-transcripts] --retries must be a non-negative integer" >&2; exit 2; }

mkdir -p "$OUT_DIR"

IDS=()
while IFS= read -r id; do
    [[ -z "$id" ]] && continue
    IDS+=("$id")
done < <(python3 -c "import csv; [print(r['id'].strip()) for r in csv.DictReader(open('${CSV}'))]" | sort -u)

UNIQ_IDS=("${IDS[@]}")

TOTAL=${#UNIQ_IDS[@]}
if [[ "$COUNT" -gt 0 ]]; then
    TOTAL="$COUNT"
fi

OK=0
MISSING=0
ERRORS=0
MANIFEST_TMP=$(mktemp)

echo "[fetch-transcripts] total unique videos in CSV: ${#UNIQ_IDS[@]}"
echo "[fetch-transcripts] processing: ${TOTAL}"

# pick_transcript <id>: collapse doubled names (<id>.en.en-orig.json3 ->
# <id>.en-orig.json3), keep one file per id preferring *-orig, delete the rest.
# Only subtitle extensions are considered -- derived .txt/.tsv files from
# bin/convert-transcripts live in the same dir and must never be pruned.
# Sets SURVIVOR to the kept path, or empty when nothing is on disk.
SUB_EXTS="json3 srv3 srv2 srv1 vtt srt ttml sbv"
pick_transcript() {
    local _id="$1" _f _base _rest _ext _noext _first _last _e
    for _e in $SUB_EXTS; do
    for _f in "$OUT_DIR"/${_id}.*.${_e}; do
        [[ -f "$_f" ]] || continue
        _base=$(basename "$_f")
        _rest=${_base#${_id}.}
        _ext=${_rest##*.}
        _noext=${_rest%.*}
        _first=${_noext%%.*}
        _last=${_noext##*.}
        if [[ "$_first" != "$_last" ]]; then
            mv -f "$_f" "$OUT_DIR/${_id}.${_last}.${_ext}"
        fi
    done
    done
    SURVIVOR=""
    for _pref in "en-orig" "es-orig" "*-orig" "en" "es"; do
        for _e in $SUB_EXTS; do
            for _f in "$OUT_DIR"/${_id}.${_pref}.${_e}; do
                [[ -f "$_f" ]] || continue
                SURVIVOR="$_f"
                break 3
            done
        done
    done
    if [[ -z "$SURVIVOR" ]]; then
        for _e in $SUB_EXTS; do
            for _f in "$OUT_DIR"/${_id}.*.${_e}; do
                [[ -f "$_f" ]] || continue
                SURVIVOR="$_f"
                break 2
            done
        done
    fi
    if [[ -n "$SURVIVOR" ]]; then
        for _e in $SUB_EXTS; do
        for _f in "$OUT_DIR"/${_id}.*.${_e}; do
            [[ -f "$_f" ]] || continue
            [[ "$_f" != "$SURVIVOR" ]] || continue
            rm -f "$_f"
        done
        done
    fi
}

fetch_one() {
    # $1 = id, $2 = sub-langs, $3 = 1 to append to the log (default truncate).
    # (Redirect operators cannot come from a variable, so route via fd 9.)
    local _id="$1" _langs="$2" _log="/tmp/fetch-transcripts-$1.log" _rc
    if [[ "${3:-0}" == 1 ]]; then
        exec 9>>"$_log"
    else
        exec 9>"$_log"
    fi
    if [[ -z "$COOKIES" ]]; then
        yt-dlp --skip-download --write-auto-subs \
            --sub-langs "$_langs" \
            --sub-format "$SUB_FORMAT" \
            -o "${OUT_DIR}/${_id}.%(ext)s" \
            --no-write-info-json \
            --no-overwrites \
            -- "https://www.youtube.com/watch?v=${_id}" >&9 2>&1
    else
        yt-dlp --skip-download --write-auto-subs \
            --sub-langs "$_langs" \
            --sub-format "$SUB_FORMAT" \
            -o "${OUT_DIR}/${_id}.%(ext)s" \
            --no-write-info-json \
            --no-overwrites \
            $COOKIES \
            -- "https://www.youtube.com/watch?v=${_id}" >&9 2>&1
    fi
    _rc=$?
    exec 9>&-
    return $_rc
}

for i in $(seq 0 $((TOTAL - 1))); do
    ID="${UNIQ_IDS[$i]}"

    pick_transcript "$ID"
    if [[ -n "$SURVIVOR" && "$FORCE" -eq 0 ]]; then
        echo "[fetch-transcripts] skip ${ID} (already exists -> $(basename "$SURVIVOR"))"
        printf '%s\t%s\t%s\n' "$ID" "ok" "$SURVIVOR" >> "$MANIFEST_TMP"
        OK=$((OK + 1))
        continue
    fi

    if [[ "$FORCE" -eq 1 ]]; then
        for _e in $SUB_EXTS; do rm -f "$OUT_DIR"/${ID}.*.${_e} 2>/dev/null || true; done
        SURVIVOR=""
    fi

    attempt=0
    while [[ $attempt -lt $RETRIES ]]; do
        attempt=$((attempt + 1))
        if fetch_one "$ID" "en-orig,es-orig,en.*,es.*" 0; then
            break
        fi
        echo "[fetch-transcripts] attempt ${attempt}/${RETRIES} failed for ${ID}, retrying in ${SLEEP}s"
        sleep "$SLEEP"
    done

    pick_transcript "$ID"
    if [[ -z "$SURVIVOR" ]]; then
        # Fallback for videos without en/es tracks: any original, then prune.
        echo "[fetch-transcripts] fallback ${ID} (trying .*-orig)"
        fetch_one "$ID" ".*-orig" 1 || true
        pick_transcript "$ID"
    fi

    if [[ -n "$SURVIVOR" ]]; then
        echo "[fetch-transcripts] ok ${ID} -> $(basename "$SURVIVOR")"
        printf '%s\t%s\t%s\n' "$ID" "ok" "$SURVIVOR" >> "$MANIFEST_TMP"
        OK=$((OK + 1))
    else
        echo "[fetch-transcripts] error ${ID}"
        printf '%s\t%s\t%s\n' "$ID" "error" "" >> "$MANIFEST_TMP"
        ERRORS=$((ERRORS + 1))
    fi

    if [[ $(( (i + 1) % 10 )) -eq 0 ]]; then
        echo "[fetch-transcripts] progress: $((i + 1))/${TOTAL}"
    fi

    if [[ $i -lt $((TOTAL - 1)) ]]; then
        sleep "$SLEEP"
    fi
done

# Build manifest: all expected IDs from CSV, joined against what we fetched (new layout: manifests/transcripts.tsv)
python3 -c "
import csv, os
expected = {}
with open('${CSV}') as f:
    for row in csv.DictReader(f):
        expected[row['id'].strip()] = True
fetched = {}
with open('${MANIFEST_TMP}') as f:
    for line in f:
        parts = line.strip().split('\t')
        if len(parts) >= 2:
            fetched[parts[0]] = parts[1]
# New layout: manifests/transcripts.tsv at bundle root (sibling of transcripts/)
out_dir='${OUT_DIR}'
bundle_root=os.path.dirname(os.path.normpath(out_dir)) or '.'
new_path=os.path.join(bundle_root, 'manifests', 'transcripts.tsv')
old_path=os.path.join(out_dir, 'manifest.tsv')
os.makedirs(os.path.dirname(new_path), exist_ok=True)
out_path=new_path
# Migrate old if present and new missing
if os.path.isfile(old_path) and not os.path.isfile(new_path):
    try:
        import shutil
        shutil.copy2(old_path, new_path)
    except:
        pass
with open(out_path, 'w') as out:
    out.write('id\tstatus\tfile\tlang\n')
    for id in sorted(expected.keys()):
        st = fetched.get(id, 'missing')
        if st == 'ok':
            with open('${MANIFEST_TMP}') as f:
                for line in f:
                    p = line.strip().split('\t')
                    if p[0] == id and p[1] == 'ok':
                        file = p[2]
                        lang = file.split('.')[-2] if '.' in file else ''
                        out.write(f'{id}\tok\t{file}\t{lang}\n')
                        break
        else:
            out.write(f'{id}\t{st}\t\t\n')
# Keep old for backward compat (if transcripts/ still has manifest, update it too)
try:
    with open(old_path, 'w') as out2:
        with open(new_path) as src:
            out2.write(src.read())
except:
    pass
"
rm -f "$MANIFEST_TMP"

MISSING=$((TOTAL - OK - ERRORS))
echo "[fetch-transcripts] done: fetched ${OK}, missing ${MISSING}, errors ${ERRORS} (of ${TOTAL})"
echo "[fetch-transcripts] manifest written to manifests/transcripts.tsv (and ${OUT_DIR}/manifest.tsv for compat)"
